{% extends 'base.html.twig' %}

{% block title %}Connexion - SmartUrgence CHU Charles Nicolle{% endblock %}

{% block body %}
<div class="login-page-body">
    <div class="login-card">
        <div class="login-brand">
            <div class="login-logo-icon">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </div>
            <h1 class="login-title">SmartUrgence</h1>
            <p class="login-subtitle">CHU Charles Nicolle — Coordination des Flux d'Urgences</p>
        </div>

        {% if error %}
            <div class="alert-banner alert-banner-danger" style="margin-bottom: 1.25rem;">
                <div class="alert-content">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span style="font-size: 0.85rem;">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            </div>
        {% endif %}

        {% if app.user %}
            <div class="alert-banner alert-banner-info" style="margin-bottom: 1.25rem;">
                <div class="alert-content">
                    <span style="font-size: 0.85rem;">Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.</span>
                </div>
                <a href="{{ logout_path() }}" class="btn btn-sm btn-secondary">Déconnexion</a>
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <div class="form-group">
                <label for="username" class="form-label">Adresse Email Professionnelle</label>
                <input type="email" value="{{ last_username|default('medecin@nicolle.tn') }}" name="_username" id="username" class="form-control" autocomplete="email" placeholder="nom.prenom@nicolle.tn" required autofocus>
            </div>

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                    <label for="password" class="form-label" style="margin-bottom: 0;">Mot de passe</label>
                    <a href="#" style="font-size: 0.75rem;">Mot de passe oublié ?</a>
                </div>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" placeholder="••••••••" required>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-primary btn-full btn-lg" type="submit" style="margin-top: 0.5rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
                Se connecter au service
            </button>
        </form>
    </div>
</div>
{% endblock %}
