{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord Coordinateur - SmartUrgence CHU Charles Nicolle{% endblock %}

{% block body %}
<div class="page-header">
    <div class="page-title-group">
        <h1>Tableau de Bord Coordinateur Service des Urgences</h1>
        <p class="page-subtitle">Vue globale multi-agents des flux hospitaliers, de la saturation et du personnel</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
        <span class="badge badge-subtle-green" style="font-size: 0.85rem; padding: 0.5rem 0.85rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            Système Multi-Agents : OPÉRATIONNEL
        </span>
    </div>
</div>

<!-- Cartes de Statistiques Clés -->
<div class="grid-4" style="margin-bottom: 1.75rem;">
    <div class="stat-card">
        <div class="stat-icon primary">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
        </div>
        <div class="stat-details">
            <span class="stat-value">{{ patients_count|default(0) }}</span>
            <span class="stat-label">Patients actuellement au service</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon alert">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path></svg>
        </div>
        <div class="stat-details">
            <span class="stat-value" style="color: #DC2626;">{{ alertes_count|default(0) }}</span>
            <span class="stat-label">Alertes de saturation actives</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon warning">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="stat-details">
            <span class="stat-value">{{ alertes_actives|length > 0 ? 'ATTENTION' : 'FLUIDE' }}</span>
            <span class="stat-label">État de Fluidité Service</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon success">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
        </div>
        <div class="stat-details">
            <span class="stat-value">{{ unites|length }}</span>
            <span class="stat-label">Unités Actives Surveillées</span>
        </div>
    </div>
</div>

<div class="grid-2">
    <!-- Vue de la Charge des Unités (Barres de Progression) -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                Charge & Saturation des Unités (Temps Réel)
            </h2>
        </div>

        {% for u in unites %}
            {% set pct = u.capaciteMax > 0 ? ((u.chargeActuelle / u.capaciteMax) * 100)|round : 0 %}
            <div class="unit-load-item">
                <div class="unit-load-header">
                    <span class="unit-name">{{ loop.index }}. {{ u.nom }}</span>
                    <span class="unit-percentage" style="color: {% if pct >= 85 %}#EF4444{% elseif pct >= 70 %}#F59E0B{% else %}#10B981{% endif %};">
                        {{ pct }}% ({{ u.chargeActuelle }} / {{ u.capaciteMax }} cap.)
                        {% if pct >= 85 %} — SATURÉ{% endif %}
                    </span>
                </div>
                <div class="progress-track">
                    <div class="progress-bar {% if pct >= 85 %}danger{% elseif pct >= 70 %}warning{% else %}ok{% endif %}" style="width: {{ pct > 100 ? 100 : pct }}%;"></div>
                </div>
            </div>
        {% else %}
            <p style="color: var(--text-muted);">Aucune unité configurée.</p>
        {% endfor %}
    </div>

    <!-- Graphique du Flux de Patients Prévu & Formulaire de Réaffectation -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle></svg>
                Envoi Manuel de Réaffectation Soignant
            </h2>
        </div>

        {% if alertes_actives is not empty and personnels_disponibles is not empty %}
            <form method="post" action="{{ path('app_coordinateur_reaffecter') }}">
                <div class="form-group">
                    <label class="form-label">Alerte de Saturation Active *</label>
                    <select name="alerte_id" class="form-select" required>
                        {% for alerte in alertes_actives %}
                            <option value="{{ alerte.idAlerte }}">
                                Alerte #{{ alerte.idAlerte }} — Unité {{ alerte.unite.nom|default('Inconnue') }} ({{ alerte.heure ? alerte.heure|date('H:i') : '--:--' }})
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Personnel Soignant Disponible *</label>
                    <select name="personnel_id" class="form-select" required>
                        {% for pers in personnels_disponibles %}
                            <option value="{{ pers.idPersonnel }}">
                                {{ pers.nom }} ({{ pers.role|default('Soignant') }}) — {{ pers.uniteAssignee.nom|default('Sans unité') }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <button type="submit" class="btn btn-primary btn-full">
                    Envoyer Demande de Renfort (Multi-Agents)
                </button>
            </form>
        {% else %}
            <p style="color: var(--text-muted); font-size: 0.9rem;">
                {% if alertes_actives is empty %}
                    Aucune alerte active à traiter pour le moment.
                {% else %}
                    Aucun personnel marqué disponible en base de données.
                {% endif %}
            </p>
        {% endif %}
    </div>
</div>

<!-- Section Prévisions d'Affluence des Urgences (Agent IA SPADE) -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <h2 class="card-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            Prévision du Flux d'Arrivée de Patients (Agent IA SPADE)
        </h2>
        {% if latest_prediction %}
            <span class="badge badge-subtle-green" style="font-size: 0.75rem;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                Modèle Actif : {{ latest_prediction.modeleUtilise|default('XGBoost') }}
            </span>
        {% endif %}
    </div>

    {% if predictions is not empty and latest_prediction is not null %}
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; align-items: stretch;">
            <!-- Encart Prochaine Prédiction Principale -->
            <div style="background: linear-gradient(135deg, var(--primary-50), #FFF0F2); border: 1.5px solid var(--triage-red-border); border-radius: var(--radius-md); padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--primary-600); letter-spacing: 0.05em; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 16 14"></polyline></svg>
                        Prochaine Prédiction Ciblée
                    </div>
                    
                    <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.25rem;">
                        <span style="font-size: 2.5rem; font-weight: 800; color: var(--primary-800); line-height: 1;">{{ latest_prediction.fluxEstime|default(0) }}</span>
                        <span style="font-size: 1rem; font-weight: 700; color: var(--primary-600);">patients estimés</span>
                    </div>

                    <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-primary); margin-top: 0.5rem;">
                        Heure ciblée : 
                        {% if latest_prediction.dateCible %}
                            <strong>{{ latest_prediction.dateCible|date('H:i') }}</strong> <span style="color: var(--text-muted); font-size: 0.825rem; font-weight: 500;">({{ latest_prediction.dateCible|date('d/m/Y') }})</span>
                        {% else %}
                            <span style="color: var(--text-muted);">Non spécifiée</span>
                        {% endif %}
                    </div>
                </div>

                <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px dashed var(--triage-red-border); font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                    <span style="display: block; margin-bottom: 0.2rem;">Modèle utilisé : <strong>{{ latest_prediction.modeleUtilise|default('XGBoost') }}</strong></span>
                    Prévision générée automatiquement par l'Agent Prédiction, à partir de l'historique réel des arrivées.
                </div>
            </div>

            <!-- Mini-Graphique & Tendance des Prédictions Récentes -->
            <div style="display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                        <span style="font-weight: 700; font-size: 0.9rem; color: var(--text-primary);">Tendance des {{ predictions|length }} Dernières Prédictions</span>
                        <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Flux par créneau</span>
                    </div>

                    {% set max_flux = 1 %}
                    {% for p in predictions %}
                        {% if p.fluxEstime and p.fluxEstime > max_flux %}
                            {% set max_flux = p.fluxEstime %}
                        {% endif %}
                    {% endfor %}

                    <div style="display: flex; align-items: flex-end; gap: 0.75rem; height: 120px; padding: 1rem 0.75rem 0.5rem 0.75rem; background: var(--bg-subtle); border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                        {% for p in predictions|reverse %}
                            {% set val = p.fluxEstime|default(0) %}
                            {% set height_pct = max_flux > 0 ? ((val / max_flux) * 100)|round : 10 %}
                            {% set is_latest = (latest_prediction and p.idPrediction == latest_prediction.idPrediction) %}
                            <div style="flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end;" title="Heure: {{ p.dateCible ? p.dateCible|date('H:i') : 'N/A' }} | Flux estimé: {{ val }} patients | Modèle: {{ p.modeleUtilise|default('XGBoost') }}">
                                <span style="font-size: 0.75rem; font-weight: 700; color: {{ is_latest ? 'var(--primary-700)' : 'var(--text-primary)' }}; margin-bottom: 0.25rem;">
                                    {{ val }}
                                </span>
                                <div style="width: 100%; max-width: 40px; height: {{ height_pct < 12 ? 12 : height_pct }}%; background: {{ is_latest ? 'linear-gradient(180deg, var(--primary-500), var(--primary-700))' : '#94A3B8' }}; border-radius: 4px 4px 0 0; transition: height 0.3s ease;"></div>
                                <span style="font-size: 0.7rem; font-weight: 600; color: {{ is_latest ? 'var(--primary-600)' : 'var(--text-muted)' }}; margin-top: 0.35rem; white-space: nowrap;">
                                    {{ p.dateCible ? p.dateCible|date('H:i') : '#' ~ p.idPrediction }}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                    Prévision générée automatiquement par l'Agent Prédiction (modèle {{ latest_prediction.modeleUtilise|default('XGBoost') }}), à partir de l'historique réel des arrivées.
                </p>
            </div>
        </div>
    {% else %}
        <!-- Cas où aucune prédiction n'existe encore -->
        <div style="padding: 1.75rem 1.25rem; text-align: center; background: var(--bg-subtle); border-radius: var(--radius-md); border: 1px dashed var(--border-color);">
            <div style="width: 48px; height: 48px; background: #FEE2E2; color: #DC2626; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 0.85rem auto;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            </div>
            <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.35rem;">
                Aucune prédiction disponible pour le moment
            </h3>
            <p style="color: var(--text-muted); font-size: 0.875rem; max-width: 600px; margin: 0 auto; line-height: 1.4;">
                Le système d'agents doit être en cours d'exécution pour générer des prévisions.
            </p>
        </div>
    {% endif %}
</div>

<!-- Section Suivi des Réaffectations & Renforts Personnel -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="card-header">
        <h2 class="card-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            Suivi des Réaffectations & Renforts Personnel
        </h2>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Personnel</th>
                    <th>Unité Fixe</th>
                    <th>Unité Cible (Renfort)</th>
                    <th>Horodatage</th>
                    <th>Statut du Renfort</th>
                </tr>
            </thead>
            <tbody>
                {% for reaf in reaffectations %}
                    <tr>
                        <td><strong>#{{ reaf.idReaffectation }}</strong></td>
                        <td><strong>{{ reaf.personnel.nom|default('Inconnu') }}</strong> ({{ reaf.personnel.role|default('Soignant') }})</td>
                        <td><span class="badge badge-neutral">{{ reaf.personnel.uniteAssignee.nom|default('Unité fixe') }}</span></td>
                        <td>
                            {% set target = reaf.uniteCible.nom|default(reaf.alerte.unite.nom|default(null)) %}
                            {% if target %}
                                <strong style="color: var(--primary-700);">{{ target }}</strong>
                            {% else %}
                                <span style="color: var(--text-muted);">Non spécifiée</span>
                            {% endif %}
                        </td>
                        <td>{{ reaf.heureNotification ? reaf.heureNotification|date('H:i:s') : '--:--' }}</td>
                        <td>
                            {% if reaf.reponse == 'en_attente' %}
                                <span class="badge badge-subtle-orange">En attente</span>
                            {% elseif reaf.reponse == 'refusee' %}
                                <span class="badge badge-neutral">Refusée</span>
                            {% elseif reaf.reponse == 'acceptee' and not reaf.renfortTermine %}
                                <span class="badge badge-subtle-red" style="font-weight: 700;">Acceptée - en cours de renfort</span>
                            {% elseif reaf.reponse == 'acceptee' and reaf.renfortTermine %}
                                <span class="badge badge-subtle-green">Renfort terminé</span>
                            {% else %}
                                <span class="badge badge-neutral">{{ reaf.reponse|default('Inconnu') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
                            Aucune réaffectation enregistrée pour le moment.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Liste des Alertes Récentes du Système Multi-Agents -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            Journal des Alertes Multi-Agents
        </h2>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>ID Alerte</th>
                    <th>Horodatage</th>
                    <th>Unité Émettrice</th>
                    <th>Type d'Alerte</th>
                    <th>Statut</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for alerte in toutes_alertes %}
                    <tr>
                        <td><strong>#{{ alerte.idAlerte }}</strong></td>
                        <td>{{ alerte.heure ? alerte.heure|date('H:i:s') : '--:--' }}</td>
                        <td><strong>{{ alerte.unite.nom|default('Générale') }}</strong></td>
                        <td>{{ alerte.type|default('saturation') }}</td>
                        <td>
                            {% if alerte.statut == 'en_cours' %}
                                <span class="badge badge-subtle-red">En cours</span>
                            {% else %}
                                <span class="badge badge-subtle-green">Traitée</span>
                            {% endif %}
                        </td>
                        <td style="text-align: right;">
                            {% if alerte.statut == 'en_cours' %}
                                <form method="post" action="{{ path('app_coordinateur_traiter_alerte', { id: alerte.idAlerte }) }}" style="display: inline-block;">
                                    <button type="submit" class="btn btn-sm btn-success">Marquer Traitée</button>
                                </form>
                            {% else %}
                                <button class="btn btn-sm btn-secondary" disabled>Traitée</button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
                            Aucune alerte enregistrée en base.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
