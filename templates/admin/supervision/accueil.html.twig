{% extends 'base.html.twig' %}

{% block title %}Supervision Accueil & Admission - Admin SmartUrgence{% endblock %}

{% block body %}
<!-- Bandeau de Mode Supervision -->
<div class="alert-banner alert-banner-info" style="margin-bottom: 1.5rem;">
    <div class="alert-content">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <span>👁️ <strong>Mode supervision</strong> — Vue en lecture seule des admissions du module <strong>Accueil & Admission</strong>.</span>
    </div>
    <a href="{{ path('app_admin') }}" class="btn btn-sm btn-secondary">Retour Admin</a>
</div>

<div class="page-header">
    <div class="page-title-group">
        <h1>Supervision : Admissions du Jour</h1>
        <p class="page-subtitle">Consultation administrative des enregistrements patients aux urgences (CHU Charles Nicolle)</p>
    </div>
    <div>
        <span class="badge badge-subtle-green" style="font-size: 0.85rem; padding: 0.5rem 0.85rem;">
            {{ admissions_count|default(0) }} Patient(s) enregistré(s)
        </span>
    </div>
</div>

<!-- Liste des Patients (Lecture Seule, Sans Formulaire d'Admission) -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Registre des Admissions (Lecture Seule)
        </h2>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>N° Ticket</th>
                    <th>Nom & Prénom</th>
                    <th>Âge / Sexe</th>
                    <th>Heure d'arrivée</th>
                    <th>Statut Triage</th>
                    <th style="text-align: right;">QR Code</th>
                </tr>
            </thead>
            <tbody>
                {% for patient in patients %}
                    <tr>
                        <td><strong>#SU-{{ patient.idPatient }}</strong></td>
                        <td><strong>{{ patient.nom }}</strong></td>
                        <td>{{ patient.age ? patient.age ~ ' ans' : 'N/A' }} / {{ patient.sexe|default('N/A') }}</td>
                        <td>{{ patient.dateArrivee ? patient.dateArrivee|date('H:i') : '--:--' }}</td>
                        <td>
                            {% if patient.gravite is null %}
                                <span class="badge badge-subtle-orange">En attente Triage</span>
                            {% elseif patient.gravite|lower == 'rouge' %}
                                <span class="badge badge-triage-rouge">ROUGE - SAUV</span>
                            {% elseif patient.gravite|lower == 'orange' %}
                                <span class="badge badge-triage-orange">ORANGE - BOX</span>
                            {% elseif patient.gravite|lower == 'jaune' %}
                                <span class="badge badge-triage-jaune">JAUNE - Consult</span>
                            {% else %}
                                <span class="badge badge-triage-vert">VERT - Léger</span>
                            {% endif %}
                        </td>
                        <td style="text-align: right;">
                            <button class="btn btn-sm btn-outline-primary" onclick="generateQRCode('{{ patient.nom|e('js') }}', '#SU-{{ patient.idPatient }}')">
                                QR Code
                            </button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                            Aucun patient enregistré aujourd'hui.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
