{% extends 'base.html.twig' %}

{% block title %}Supervision Soignants - Admin SmartUrgence{% endblock %}

{% block body %}
<!-- Bandeau de Mode Supervision -->
<div class="alert-banner alert-banner-info" style="margin-bottom: 1.5rem;">
    <div class="alert-content">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <span>👁️ <strong>Mode supervision</strong> — Vue en lecture seule des lits et des passages du module <strong>Soignants d'Unité</strong>.</span>
    </div>
    <a href="{{ path('app_admin') }}" class="btn btn-sm btn-secondary">Retour Admin</a>
</div>

<div class="page-header">
    <div class="page-title-group">
        <h1>Supervision : Postes Soignants par Unité</h1>
        <p class="page-subtitle">Sélectionnez une unité pour consulter l'occupation des lits et la liste des patients en cours de soin</p>
    </div>
    
    <!-- Sélecteur d'Unité pour l'Administrateur -->
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <label for="select-unite-supervision" style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted);">Sélecteur d'Unité :</label>
        <select id="select-unite-supervision" class="form-select" style="min-width: 220px; font-weight: 700; border-color: var(--primary-600);" onchange="location.href = '{{ path('app_admin_supervision_soignant', { idUnite: 'UNIT_ID' }) }}'.replace('UNIT_ID', this.value);">
            {% for u in unites %}
                <option value="{{ u.idUnite }}" {% if unite and u.idUnite == unite.idUnite %}selected{% endif %}>
                    Unité {{ u.nom }} ({{ u.chargeActuelle }}/{{ u.capaciteMax }})
                </option>
            {% endfor %}
        </select>
    </div>
</div>

<!-- Cartes d'Occupation pour l'Unité Sélectionnée -->
<div class="grid-3" style="margin-bottom: 1.5rem;">
    <div class="stat-card">
        <div class="stat-icon primary">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
        </div>
        <div class="stat-details">
            <span class="stat-value">{{ lits_occupes|default(0) }} / {{ unite.capaciteMax|default(10) }}</span>
            <span class="stat-label">Lits occupés ({{ unite.nom|default('Unité') }})</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon warning">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="stat-details">
            <span class="stat-value">Charge : {{ unite.chargeActuelle|default(0) }}</span>
            <span class="stat-label">Capacité maximale : {{ unite.capaciteMax|default(10) }}</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon success">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <div class="stat-details">
            <span class="stat-value">
                {% if unite and unite.estSature() %}
                    SATURÉ
                {% else %}
                    NORMAL
                {% endif %}
            </span>
            <span class="stat-label">État de Saturation</span>
        </div>
    </div>
</div>

<!-- Liste des Patients Présents (Lecture Seule, Sans Bouton Scan Sortie) -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            Patients actuellement dans l'Unité {{ unite.nom|default('Sélectionnée') }} (Lecture Seule)
        </h2>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Passage N°</th>
                    <th>Patient</th>
                    <th>Gravité Triage</th>
                    <th>Heure d'entrée</th>
                    <th>Statut</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for passage in passages %}
                    <tr>
                        <td><strong style="color: var(--primary-700);">Passage #{{ passage.idPassage }}</strong></td>
                        <td><strong>{{ passage.patient.nom|default('Inconnu') }}</strong> (#SU-{{ passage.patient.idPatient }})</td>
                        <td>
                            {% set grav = passage.patient.gravite|default('')|lower %}
                            {% if grav == 'rouge' %}
                                <span class="badge badge-triage-rouge">ROUGE</span>
                            {% elseif grav == 'orange' %}
                                <span class="badge badge-triage-orange">ORANGE</span>
                            {% elseif grav == 'jaune' %}
                                <span class="badge badge-triage-jaune">JAUNE</span>
                            {% elseif grav == 'vert' %}
                                <span class="badge badge-triage-vert">VERT</span>
                            {% else %}
                                <span class="badge badge-neutral">Non défini</span>
                            {% endif %}
                        </td>
                        <td>{{ passage.heureEntree ? passage.heureEntree|date('H:i') : '--:--' }}</td>
                        <td><span class="badge badge-subtle-orange">En cours de soin</span></td>
                        <td style="text-align: right;">
                            <span class="badge badge-neutral">Lecture seule</span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                            Aucun patient en cours de prise en charge dans l'unité {{ unite.nom|default('') }}.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
