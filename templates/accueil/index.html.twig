{% extends 'base.html.twig' %}

{% block title %}Accueil Patients - SmartUrgence CHU Charles Nicolle{% endblock %}

{% block body %}
<div class="page-header">
    <div class="page-title-group">
        <h1>Interface Accueil & Admission</h1>
        <p class="page-subtitle">Enregistrement initial des patients et délivrance des identifiants QR Code</p>
    </div>
    <div>
        <span class="badge badge-neutral" style="font-size: 0.85rem; padding: 0.5rem 0.85rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Session Active : Guichet 01
        </span>
    </div>
</div>

<div class="grid-sidebar">
    <!-- Formulaire d'Enregistrement Patient -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="17" y1="11" x2="23" y2="11"></line></svg>
                Nouvelle Admission
            </h2>
        </div>

        <form method="post" action="{{ path('app_accueil_nouveau_patient') }}">
            <div class="form-group">
                <label class="form-label" for="nom_prenom">Nom & Prénom du patient *</label>
                <input type="text" id="nom_prenom" name="nom_prenom" class="form-control" placeholder="ex: Ben Ali Mohamed" required>
            </div>

            <div class="grid-2" style="gap: 0.75rem;">
                <div class="form-group">
                    <label class="form-label" for="age">Âge *</label>
                    <input type="number" id="age" name="age" class="form-control" placeholder="ex: 45" min="0" max="120" required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="sexe">Sexe *</label>
                    <select id="sexe" name="sexe" class="form-select" required>
                        <option value="">Sélect.</option>
                        <option value="Homme">Homme (M)</option>
                        <option value="Femme">Femme (F)</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="motif">Motif d'admission principal</label>
                <textarea id="motif" name="motif" class="form-control" rows="3" placeholder="ex: Douleur thoracique intense, vertiges..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-full btn-lg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Enregistrer & Envoyer au Triage
            </button>
        </form>
    </div>

    <!-- Liste des Patients Enregistrés Aujourd'hui -->
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--primary-600);"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                Admissions du Jour (CHU Charles Nicolle)
            </h2>
            <span class="badge badge-subtle-green">{{ admissions_count|default(0) }} Patient(s) enregistré(s)</span>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>N° Ticket</th>
                        <th>Nom & Prénom</th>
                        <th>Âge / Sexe</th>
                        <th>Heure d'arrivée</th>
                        <th>Statut</th>
                        <th style="text-align: right;">Action QR</th>
                    </tr>
                </thead>
                <tbody>
                    {% for patient in patients %}
                        <tr>
                            <td><strong>#SU-{{ patient.idPatient }}</strong></td>
                            <td><strong>{{ patient.nom }}</strong></td>
                            <td>{{ patient.age ? patient.age ~ ' ans' : 'N/A' }} / {{ patient.sexe|default('N/A') }}</td>
                            <td>{{ patient.dateArrivee ? patient.dateArrivee|date('H:i') : '--:--' }}</td>
                            <td>
                                {% if patient.gravite is null %}
                                    <span class="badge badge-subtle-orange">En attente Triage</span>
                                {% elseif patient.gravite|lower == 'rouge' %}
                                    <span class="badge badge-triage-rouge">ROUGE - SAUV</span>
                                {% elseif patient.gravite|lower == 'orange' %}
                                    <span class="badge badge-triage-orange">ORANGE - BOX</span>
                                {% elseif patient.gravite|lower == 'jaune' %}
                                    <span class="badge badge-triage-jaune">JAUNE - Consult</span>
                                {% else %}
                                    <span class="badge badge-triage-vert">VERT - Léger</span>
                                {% endif %}
                            </td>
                            <td style="text-align: right;">
                                <button class="btn btn-sm btn-outline-primary" onclick="openQrModal('{{ patient.idPatient }}', '{{ patient.nom|e('js') }}', '{{ patient.dateArrivee ? patient.dateArrivee|date('d/m/Y H:i') : '' }}')">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                                    Afficher QR & Ticket
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                                Aucun patient en cours d'admission pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal QR Code & Ticket d'Admission -->
<div id="qrModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center; padding: 1rem;">
    <div style="background: white; border-radius: 12px; max-width: 420px; width: 100%; padding: 1.5rem; text-align: center; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2);" id="printableTicket">
        <div style="border-bottom: 2px dashed #E2E8F0; padding-bottom: 1rem; margin-bottom: 1rem;">
            <h3 style="margin: 0; color: #1E293B; font-size: 1.2rem; font-weight: 700;">CHU Charles Nicolle</h3>
            <p style="margin: 0.25rem 0 0; color: #64748B; font-size: 0.85rem;">SmartUrgence - Ticket d'Admission Patient</p>
        </div>

        <div style="margin: 1rem 0;">
            <img id="qrModalImage" src="" alt="QR Code Patient" style="width: 180px; height: 180px; border-radius: 8px; border: 1px solid #E2E8F0; padding: 0.5rem; background: white;">
        </div>

        <div style="text-align: left; background: #F8FAFC; padding: 0.85rem; border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.9rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                <span style="color: #64748B;">N° Ticket :</span>
                <strong id="qrModalTicket" style="color: #0284C7; font-size: 1rem;">#SU--</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.35rem;">
                <span style="color: #64748B;">Patient :</span>
                <strong id="qrModalNom" style="color: #1E293B;">--</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: #64748B;">Date d'arrivée :</span>
                <span id="qrModalDate" style="color: #475569;">--</span>
            </div>
        </div>

        <div class="no-print" style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn btn-secondary" onclick="closeQrModal()">Fermer</button>
            <button type="button" class="btn btn-primary" onclick="window.print()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                Imprimer Ticket
            </button>
        </div>
    </div>
</div>

<style>
@media print {
    body * {
        visibility: hidden;
    }
    #printableTicket, #printableTicket * {
        visibility: visible;
    }
    #printableTicket {
        position: absolute;
        left: 50%;
        top: 20%;
        transform: translateX(-50%);
        width: 100%;
        max-width: 400px;
        box-shadow: none !important;
        border: 1px solid #CBD5E1;
    }
    .no-print {
        display: none !important;
    }
}
</style>

<script>
function openQrModal(id, nom, dateArrivee) {
    const modal = document.getElementById('qrModal');
    const qrImg = document.getElementById('qrModalImage');
    const qrTicket = document.getElementById('qrModalTicket');
    const qrNom = document.getElementById('qrModalNom');
    const qrDate = document.getElementById('qrModalDate');

    qrImg.src = "{{ path('app_patient_qrcode', {id: 'PATIENT_ID'}) }}".replace('PATIENT_ID', id);
    qrTicket.textContent = '#SU-' + id;
    qrNom.textContent = nom;
    qrDate.textContent = dateArrivee || '--';

    modal.style.display = 'flex';
}

function closeQrModal() {
    document.getElementById('qrModal').style.display = 'none';
}
</script>
{% endblock %}
